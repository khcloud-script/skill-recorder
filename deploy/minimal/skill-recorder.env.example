# ============================================================
# Skill Recorder 私有 LLM 配置（复制为 ~/.config/skill-recorder/llm.env）
# 只保留你实际使用的一组即可；所有 SKILL_RECORDER_LLM_* 变量都不设置时，
# 应用使用 GitHub Copilot CLI（官方默认，需公网 + Copilot 订阅）。
# ============================================================

# ---------- ① vLLM 自建（企业内网推荐） ----------
# SKILL_RECORDER_LLM_PROVIDER=vllm
# SKILL_RECORDER_LLM_BASE_URL=http://gpu01.intra.company:8000/v1
# SKILL_RECORDER_LLM_MODEL=qwen-vl
# # SKILL_RECORDER_LLM_API_KEY=        # vLLM 默认无鉴权，可留空

# ---------- ② Ollama（单机/小团队最简） ----------
# SKILL_RECORDER_LLM_PROVIDER=ollama
# SKILL_RECORDER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SKILL_RECORDER_LLM_MODEL=qwen2.5vl:32b

# ---------- ③ Litellm / One-API 网关（完整部署推荐） ----------
# SKILL_RECORDER_LLM_PROVIDER=custom
# SKILL_RECORDER_LLM_BASE_URL=http://litellm.intra.company:4000/v1
# SKILL_RECORDER_LLM_API_KEY=sk-xxxx
# SKILL_RECORDER_LLM_MODEL=qwen-vl                # 网关别名

# ---------- ④ DeepSeek（公有云 API，允许出网时使用） ----------
# SKILL_RECORDER_LLM_PROVIDER=deepseek
# SKILL_RECORDER_LLM_API_KEY=sk-xxxx
# # DeepSeek 为纯文本模型，截图会被跳过：
# SKILL_RECORDER_LLM_VISION=0

# ---------- ⑤ 智谱 GLM ----------
# SKILL_RECORDER_LLM_PROVIDER=zhipu
# SKILL_RECORDER_LLM_API_KEY=xxxx.yyyy
# SKILL_RECORDER_LLM_MODEL=glm-4-plus

# ---------- ⑥ 通义千问 ----------
# SKILL_RECORDER_LLM_PROVIDER=qwen
# SKILL_RECORDER_LLM_API_KEY=sk-xxx
# SKILL_RECORDER_LLM_MODEL=qwen-max

# ---------- 通用调优（可选） ----------
# SKILL_RECORDER_LLM_VISION_MODEL=qwen2.5-vl      # 视觉帧分析专用模型
# SKILL_RECORDER_LLM_VISION=1                     # 1/0 强制开关图像输入
# SKILL_RECORDER_LLM_MAX_TOKENS=8192              # 单次响应 token 上限
